{
	"name": "@milanglacier/pi-request-user-input",
	"version": "0.2.0",
	"description": "A pi extension that adds the request_user_input tool for asking the user short questions with optional multiple-choice answers.",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"request-user-input",
		"user-input"
	],
	"homepage": "https://github.com/milanglacier/pi-request-user-input",
	"bugs": {
		"url": "https://github.com/milanglacier/pi-request-user-input/issues"
	},
	"license": "MIT",
	"author": "Milan Glacier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/milanglacier/pi-request-user-input.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm test",
		"pack:dry-run": "npm pack --dry-run"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.4.0 <2.0.0",
		"@earendil-works/pi-ai": ">=1.4.0 <2.0.0",
		"@earendil-works/pi-coding-agent": ">=1.4.0 <2.0.0",
		"@earendil-works/pi-tui": ">=1.4.0 <2.0.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^26.6.5",
		"typebox": "1.3.27",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
